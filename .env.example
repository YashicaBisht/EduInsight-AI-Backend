# Database Configuration
# Local SQLite:
DATABASE_URL=sqlite:///data/eduinsight.db
# Cloud PostgreSQL (e.g. Render / Railway):
# DATABASE_URL=postgresql://user:password@hostname:5432/database_name

# JWT & Authentication Configuration
JWT_SECRET_KEY=eduinsight_super_secret_jwt_key_for_applied_ai_platform
SECRET_KEY=eduinsight_super_secret_jwt_key_for_applied_ai_platform
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server & CORS Configuration
ENVIRONMENT=production
CORS_ORIGINS=*
PORT=8000
HOST=0.0.0.0
STARTING_STUDENT_CODE=100001

# Machine Learning Risk Prediction Thresholds
HIGH_RISK_THRESHOLD=0.60
MEDIUM_RISK_THRESHOLD=0.30
DEFAULT_RESPONSE_TIME_MS=5000

# Bayesian Knowledge Tracing (BKT) Parameters
BKT_P_INIT=0.20
BKT_P_LEARN=0.15
BKT_P_GUESS=0.20
BKT_P_SLIP=0.10
MASTERY_HIGH_THRESHOLD=0.80
MASTERY_MED_THRESHOLD=0.60

# Recommendation Service Thresholds
REC_HIGH_ATTEMPTS=2.5
REC_HIGH_HINTS=1.5
REC_HIGH_RESPONSE_TIME_MS=10000.0
REC_MASTERY_LOW=0.40
REC_MASTERY_MED=0.60
REC_MASTERY_HIGH=0.80

# SHAP Service Thresholds
SHAP_HIGH_RESPONSE_TIME_MS=8000.0

# Seeding Configuration
SEED_TEACHER_NAME=Dr. Sarah Jenkins
